PORT=3000

# --- Database: Supabase (PostgreSQL) ---
# Lokal / VPS : Connect > "Session pooler"     (port 5432)
# Netlify     : Connect > "Transaction pooler" (port 6543)
# Ganti [YOUR-PASSWORD] dengan password database (tanpa tanda kurung siku).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Isi false hanya untuk Postgres lokal tanpa SSL
DATABASE_SSL=true
# Opsional tapi disarankan: CA Supabase (isi PEM, baris baru ditulis \n) supaya sertifikat server diverifikasi.
# Tanpa ini koneksi tetap terenkripsi, tetapi identitas server tidak dicek.
# DATABASE_SSL_CA=

# --- Supabase Storage (foto avatar) ---
# Kosongkan keduanya untuk menyimpan avatar di folder uploads/ (hanya untuk dev lokal)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings > API Keys > Secret key (sb_secret_...). RAHASIA, jangan di-commit.
SUPABASE_SECRET_KEY=

# --- Aset game (gambar/audio) ---
# Diisi otomatis dari SUPABASE_URL (bucket "assets"), jadi biasanya tidak perlu diisi.
# Isi dengan kosong (ASSET_BASE=) untuk memakai folder assets/ lokal saat dev,
# atau URL lain jika aset dipindah ke CDN/R2.
# ASSET_BASE=

# URL publik situs untuk link reset password (mis. https://namasitus.netlify.app)
BASE_URL=

# --- SMTP untuk email reset password (Gmail: pakai App Password BARU) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bitgarden.game
SMTP_FROM_NAME=Bit Garden
