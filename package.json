{
  "name": "bitgarden",
  "version": "2.1.0",
  "description": "Bit Garden - retro farming game (Node.js + Express + Supabase/PostgreSQL)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/gen-config.js",
    "start": "node server.js",
    "predev": "node scripts/gen-config.js",
    "dev": "node --watch server.js",
    "build": "node scripts/gen-config.js",
    "upload-assets": "node scripts/upload-assets.js",
    "check": "node scripts/check-data.js",
    "test": "npm run check && node --import ./tests/register.mjs tests/backend.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "serverless-http": "^3.2.0"
  }
}
